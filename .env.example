# Copy to .env and fill in. Never commit the filled-in file.

# ── broker ───────────────────────────────────────────────────────────────────
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE=neewertv
# Home Assistant's discovery prefix. Only change it if you changed it there.
DISC_PREFIX=homeassistant

# ── device ───────────────────────────────────────────────────────────────────
# Unique entity id. MUST differ between two containers, or Home Assistant sees
# one light flickering between two devices.
DEVICE_ID=neewer_ns03
DEVICE_NAME=TV Backlight
# A pattern, not a model string: the 5 m model is NH-PD20250145 and the 3 m is
# NH-PD20250103. See the README for what happens with two strips present.
BLE_NAME_MATCH=NH-PD*

# Only for two or more strips: which one this container owns. Public address that
# survived a power cycle in testing; not proven across a long power-off. Leave
# blank with a single strip.
BLE_DEVICE_ADDRESS=
# How long to scan before concluding the strip is not there. Raise it if yours
# is slow to advertise.
BLE_SCAN_SECONDS=12
# Poke an idle link this often. The strip closes a link it has heard nothing on
# after about 41 seconds, so this sits comfortably inside that; 0 sends nothing.
# It does not prevent every drop — links have also been lost well beyond that
# window with the keep-alive running.
BLE_KEEPALIVE_SECONDS=20

# ── alerts ───────────────────────────────────────────────────────────────────
# Buttons on the Home Assistant device page. Any of: red, orange, yellow, lime,
# green, cyan, blue, purple, pink, white — or "none" for no buttons at all.
ALERT_BUTTONS=red,blue,green
# Seconds each button flashes for (1–300).
ALERT_BUTTON_LENGTH=10

# ── container ────────────────────────────────────────────────────────────────
TZ=Europe/London
WEB_PORT=8080
# off | observe. Observe serves the status page and log tail; nothing on the
# web side can change the strip, because there is no longer a route that can.
WEB_INTERFACE=observe
# Where the page listens inside the container. Change the HOST PORT in the
# compose file instead if you just want it somewhere else on the host.
WEB_BIND=0.0.0.0:8080
LOG_LEVEL=info
LOG_FORMAT=text
