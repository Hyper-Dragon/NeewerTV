# Copy to .env and fill in. Never commit the filled-in file.

# ── broker ───────────────────────────────────────────────────────────────────
MQTT_HOST=192.168.1.10
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE=neewertv

# ── device ───────────────────────────────────────────────────────────────────
# A pattern, not a model string: the 5 m model is NH-PD20250145 and the 3 m is
# NH-PD20250103. See the README for what happens with two strips present.
BLE_NAME_MATCH=NH-PD*

# Only for two or more strips: which one this container owns. Public address that
# survived a power cycle in testing; not proven across a long power-off. Leave
# blank with a single strip.
BLE_DEVICE_ADDRESS=

# ── container ────────────────────────────────────────────────────────────────
TZ=Europe/London
WEB_PORT=8080
WEB_INTERFACE=full
LOG_LEVEL=info
LOG_FORMAT=text
