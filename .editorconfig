root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,html,toml,md}]
indent_size = 2

[*.rs]
max_line_length = 100
# Group std/external/crate imports the way rustfmt's default ordering expects.
ij_rust_imports_layout = *, crate::*, self::*

[*.md]
# Trailing double-space is a hard line break in Markdown; never strip it silently.
trim_trailing_whitespace = false
